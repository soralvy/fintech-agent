# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secrets have no defaults; the application refuses to start without them.

# Application database (docs/SPEC.md section 14).
DATABASE_URL=postgresql://localhost:5433/fintech

# Database used by the integration tests. Its tables are DROPPED on every run,
# so it must never point at a database whose contents matter. The fixtures
# refuse any database whose name does not end in _test, or that is the
# DATABASE_URL target. scripts/verify.py requires this variable.
TEST_DATABASE_URL=postgresql://localhost:5433/fintech_test

# OpenAI (docs/SPEC.md section 14). Required: the application refuses to start
# without a key. Never commit a real key.
OPENAI_API_KEY=
# Optional, and pinned: leave them unset, or set exactly these values. Stored
# vectors are only comparable with vectors from the same model, so any other
# model, or a dimension other than 1536, stops the application at startup.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional answer model; unset or blank means gpt-6-luna. Any model set here must
# support the Responses API with Structured Outputs and reasoning effort "none".
# OPENAI_LLM_MODEL=gpt-6-luna

# Optional upload limit in bytes; default 10 MiB.
# MAX_UPLOAD_BYTES=10485760

# Optional retrieval tuning (docs/SPEC.md section 9). RETRIEVAL_TOP_K is a
# positive integer; the minimum cosine similarity is a heuristic in [0, 1], not a
# probability. Read at startup: an invalid value stops the application.
# RETRIEVAL_TOP_K=6
# MIN_RETRIEVAL_SIMILARITY=0.30

# Optional: where tiktoken caches the cl100k_base encoding. When unset it uses
# <system temp>/data-gym-cache and downloads the file once on first ingestion.
# TIKTOKEN_CACHE_DIR=
