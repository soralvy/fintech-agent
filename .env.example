# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secrets have no defaults; the application refuses to start without them.

# Application database (docs/SPEC.md section 14).
DATABASE_URL=postgresql://localhost:5433/fintech

# Database used by the integration tests. Its tables are DROPPED on every run,
# so it must never point at a database whose contents matter.
TEST_DATABASE_URL=postgresql://localhost:5433/fintech_test
