{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "ask": [
            "Bash(git switch *)",
            "Bash(git fetch *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(gh pr create *)",
            "Bash(gh pr edit *)",
            "Bash(gh pr ready *)"
        ],
        "deny": [
            "Bash(git push *--force*)",
            "Bash(git reset --hard *)",
            "Bash(git clean *)",
            "Bash(git commit *--amend*)",
            "Bash(git rebase *)",
            "Bash(git merge *)",
            "Bash(git cherry-pick *)",
            "Bash(git checkout -- *)",
            "Bash(git restore *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr close *)"
        ]
    }
}